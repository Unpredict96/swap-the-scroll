# Copy to .env and fill in. .env is gitignored — never commit real keys.

# https://fred.stlouisfed.org/docs/api/api_key.html  (free, instant)
FRED_API_KEY=

# https://agsi.gie.eu  — register, key arrives by email (free)
GIE_API_KEY=

# https://www.eia.gov/opendata/register.php  (free, instant)
EIA_API_KEY=

# https://transparency.entsoe.eu  — free, request via support form
ENTSOE_API_KEY=
